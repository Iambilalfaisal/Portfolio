# Copy this file to .env.local and fill in real values. .env.local is already gitignored —
# never commit real SMTP credentials.

# SMTP server the contact form sends through.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# true for port 465 (implicit TLS), false for port 587 (STARTTLS). Optional — inferred
# from SMTP_PORT if omitted.
SMTP_SECURE=true

# Authenticated mailbox the message is sent FROM. For Gmail this must be a 16-character
# App Password, not your normal login password — see SMTP_SETUP.md.
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password

# Where contact-form submissions land. Defaults to SMTP_USER if omitted.
CONTACT_TO_EMAIL=Bilalfaisal100@gmail.com
